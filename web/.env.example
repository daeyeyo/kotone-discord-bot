# =============================================================================
# Kotone Bot Companion Web App — Environment Configuration
# Copy this file to `.env.local` inside `kotone-discord-bot/web/`
# =============================================================================

# 1. Shared SQLite Database Path
# Relative to `kotone-discord-bot/web/` (default: ../kpop_cards.db).
# In production Docker Compose, point this to the mounted volume path
# (e.g. /app/data/kpop_cards.db). Phase 1 opens this file strictly READ-ONLY.
DATABASE_PATH=../kpop_cards.db

# 2. Auth.js Session Secret
# Generate a strong random secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-32-byte-random-hex-secret

# 3. Discord OAuth2 Credentials
# Setup steps in Discord Developer Portal (https://discord.com/developers/applications):
#   a) Open your Kotone Bot application (or create a separate dev app).
#   b) Go to OAuth2 -> General -> Redirects and add:
#        http://localhost:3000/api/auth/callback/discord
#      (Add your production URL later, e.g. https://yourdomain.com/api/auth/callback/discord)
#   c) Copy the Client ID and Client Secret below:
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# 4. Discord Bot Token (Optional)
# Used read-only by the web app to resolve real Discord display names
# (`global_name || username`) and avatars for players missing usernames in
# `kpop_cards.db`. Results are cached for 24 hours in memory and
# `web/.cache/discord-users.json`.
DISCORD_BOT_TOKEN=
